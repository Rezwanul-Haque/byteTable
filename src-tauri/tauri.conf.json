{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteTable",
  "mainBinaryName": "bytetable",
  "version": "0.0.41",
  "identifier": "com.bytetable.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteTable",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost data: blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/wallpaper"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Developer Tool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/bytetable.xml": "linux/bytetable-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.sqlite3.svg": "icons/document/linux/application-vnd.sqlite3.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.sqlite3.png": "icons/document/linux/application-vnd.sqlite3.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.sqlite3.png": "icons/document/linux/application-vnd.sqlite3.128.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-sql.svg": "icons/document/linux/application-sql.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-sql.png": "icons/document/linux/application-sql.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-sql.png": "icons/document/linux/application-sql.128.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/text-x-sql.svg": "icons/document/linux/text-x-sql.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/text-x-sql.png": "icons/document/linux/text-x-sql.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/text-x-sql.png": "icons/document/linux/text-x-sql.128.png"
        }
      },
      "rpm": {
        "desktopTemplate": "./linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/bytetable.xml": "linux/bytetable-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.sqlite3.svg": "icons/document/linux/application-vnd.sqlite3.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.sqlite3.png": "icons/document/linux/application-vnd.sqlite3.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.sqlite3.png": "icons/document/linux/application-vnd.sqlite3.128.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-sql.svg": "icons/document/linux/application-sql.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-sql.png": "icons/document/linux/application-sql.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-sql.png": "icons/document/linux/application-sql.128.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/text-x-sql.svg": "icons/document/linux/text-x-sql.svg",
          "/usr/share/icons/hicolor/48x48/mimetypes/text-x-sql.png": "icons/document/linux/text-x-sql.48.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/text-x-sql.png": "icons/document/linux/text-x-sql.128.png"
        }
      }
    },
    "resources": {
      "icons/document/document-db.icns": "document-db.icns",
      "icons/document/document-sql.icns": "document-sql.icns",
      "icons/document/windows/document-db.ico": "document-db.ico",
      "icons/document/windows/document-sql.ico": "document-sql.ico"
    },
    "fileAssociations": [
      {
        "ext": ["sqlite", "sqlite3", "db", "db3"],
        "name": "SQLite Database",
        "description": "SQLite database file",
        "role": "Editor",
        "mimeType": "application/vnd.sqlite3"
      },
      {
        "ext": ["sql"],
        "name": "SQL Script",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "application/sql;text/x-sql"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rezwanul-Haque/byteTable/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFOTcyNDNEQ0QzRUVFQUEKUldTcTdqN05QU1NYZmsxaUZEQ3RaY0g5MFEwMk01WkxMa1NjRmdJK2srdTN6bURvWjI3QTVrUkMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
